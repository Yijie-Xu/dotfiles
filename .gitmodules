[submodule "catppuccin/zsh-syntax-highlighting"]
	path = zsh/.zsh/plugins/catppuccin/zsh-syntax-highlighting
	url = https://github.com/catppuccin/zsh-syntax-highlighting.git
[submodule "catppuccin/fzf"]
	path = fzf/.config/fzf/catppuccin/fzf
	url = https://github.com/catppuccin/fzf.git
[submodule "tmux-plugins/tpm"]
	path = tmux/.config/tmux/tpm
	url = https://github.com/tmux-plugins/tpm.git
[submodule "catppuccin/grub"]
	path = grub/catppuccin/grub
	url = https://github.com/catppuccin/grub.git
[submodule "catppuccin/qt5ct"]
	path = qt/.config/qt6ct/catppuccin/qt5ct
	url = https://github.com/catppuccin/qt5ct.git
